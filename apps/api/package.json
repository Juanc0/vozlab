{
  "name": "@vozlab/api",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@vozlab/database": "workspace:*",
    "@vozlab/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vozlab/ts-config": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "jsonwebtoken": "^9.0.2"
  }
}
