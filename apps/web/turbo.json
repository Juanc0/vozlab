{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [".svelte-kit/**", "build/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": []
