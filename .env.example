# Copy to `.env` and fill in. `.env` is git-ignored.
# Values below match the local docker-compose services (postgres/postgres, localhost).

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (Router) ---
ROUTER_DB_HOST=localhost
ROUTER_DB_PORT=5432
ROUTER_DB_USER=postgres
ROUTER_DB_PASSWORD=postgres
ROUTER_DB_NAME=vozlab
ROUTER_DB_MAX_CONNECTIONS=20
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Identity / JWT ---
# JWT_SECRET must be at least 32 chars.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
# Institutional salt (>=16 chars) mixed into every derived `author_hash`.
# Per-institution config: rotating it re-keys every pseudonym.
AUTHOR_HASH_SALT=dev-institutional-salt-change-me

# --- OIDC (delegated identity) ---
OIDC_CLIENT_ID=vozlab-api
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_AUTH_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/token
OIDC_USERINFO_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/userinfo
OIDC_SCOPES=openid profile email

# --- LLM / Embeddings ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Rate limiting ---
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- Observability ---
LOG_LEVEL=info
LOG_PRETTY=true
