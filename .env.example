# Copy to the repository root as `.env` and fill in. `.env` is git-ignored.
# It is loaded automatically by the API and the database scripts through
# `tsx --env-file-if-exists=../../.env`
# (i.e. `pnpm --filter @vozlab/api dev`, `pnpm --filter @vozlab/database db:mint-token`).
# No `.env` file is required in production: env comes from the orchestrator and
# variables already present in the process environment always win.
# Values below match the local docker-compose services (postgres/postgres, localhost).

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (Router) ---
ROUTER_DB_HOST=localhost
ROUTER_DB_PORT=5432
ROUTER_DB_USER=postgres
ROUTER_DB_PASSWORD=postgres
ROUTER_DB_NAME=vozlab_router
ROUTER_DB_MAX_CONNECTIONS=20
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Identity / JWT ---
# JWT_SECRET must be at least 32 chars. Access tokens are short-lived; the
# 30-day credential is the rotating refresh token in an HttpOnly cookie.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OIDC (delegated identity) ---
# The callback must be registered on the IdP and match the API route exactly.
OIDC_CLIENT_ID=vozlab-api
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_ISSUER=http://localhost:8080/realms/vozlab
OIDC_AUTH_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/token
OIDC_USERINFO_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/userinfo
OIDC_JWKS_URL=http://localhost:8080/realms/vozlab/protocol/openid-connect/certs
OIDC_SCOPES=openid profile email
# PWA origin: CORS allowlist and the post-login redirect target.
WEB_ORIGIN=http://localhost:5173

# --- LLM / Embeddings ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Python workers (dev) ---
# The workers read these only when they mint their own agent token with
# JWT_SECRET (development path, ADR-0021). Production workers use
# AGENT_TOKEN or AGENT_TOKEN_FILE instead.
# The identity values are the dev fixtures from
# `packages/database/scripts/dev-identities.ts`:
#   embedder    -> AGENT_EMBEDDER   (44444444-...-448)
#   agent       -> AGENT_RELACIONADOR (44444444-...-447)
AGENT_TENANT_KEY=sabana
AGENT_USER_ID=44444444-4444-4444-8444-444444444448
AGENT_AUTHOR_HASH=3909e5bbd80f2f103337546c552c3cca60be32c2d47f9be64d641ea001c3250b
# Chat model used by the Relator (the embedder uses EMBEDDING_MODEL).
OLLAMA_CHAT_MODEL=llama3.1:8b

# --- Rate limiting ---
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Coarse per-workspace ceiling = per-actor max × this factor.
RATE_LIMIT_WORKSPACE_MULTIPLIER=10

# --- Observability ---
LOG_LEVEL=info
LOG_PRETTY=true
