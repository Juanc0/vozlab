# Copy to the repository root as `.env` and fill in. `.env` is git-ignored.
# It is loaded automatically by the API and the database scripts through
# `tsx --env-file-if-exists=../../.env`
# (i.e. `pnpm --filter @vozlab/api dev`, `pnpm --filter @vozlab/database db:mint-token`).
# No `.env` file is required in production: env comes from the orchestrator and
# variables already present in the process environment always win.
# Values below match the local docker-compose services (postgres/postgres, localhost).

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (Router) ---
ROUTER_DB_HOST=localhost
ROUTER_DB_PORT=5432
ROUTER_DB_USER=postgres
ROUTER_DB_PASSWORD=postgres
ROUTER_DB_NAME=vozlab_router
ROUTER_DB_MAX_CONNECTIONS=20
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Identity / JWT ---
# JWT_SECRET must be at least 32 chars. Access tokens are short-lived; the
# 30-day credential is the rotating refresh token in an HttpOnly cookie.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OIDC (delegated identity) ---
# The callback must be registered on the IdP and match the API route exactly.
# Broker: Zitadel (MIT, Go, ~128 MB RAM). It is part of the main compose file
# under the `idp` profile:
#
#   docker compose --profile idp up -d zitadel-db zitadel
#   ./scripts/setup-zitadel.sh
#
# The first init creates the machine user `vozlab-bootstrap` (IAM_OWNER) and
# writes its PAT to `.zitadel-bootstrap/admin.pat` (gitignored). The setup
# script uses that PAT to create the `vozlab` project, the `vozlab-api` OIDC
# app and the `testuser` test user, then prints the values below and the SQL
# that points the `sabana` tenant at the Zitadel org.
# Console: http://localhost:8081/ui/console (zitadel-admin@zitadel.localhost / Password1!)
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# Optional: a manually created IAM_OWNER PAT for a script run without the
# bootstrap file. Leave empty to use `.zitadel-bootstrap/admin.pat`.
ZITADEL_ADMIN_PAT=
# Optional: bootstrap dir / PAT path overrides (defaults shown).
# ZITADEL_BOOTSTRAP_DIR=./.zitadel-bootstrap
# ZITADEL_ADMIN_PAT_FILE=./.zitadel-bootstrap/admin.pat

# Public demo behind zrok (see docs/runbook-demo-zrok.md). Restart Zitadel with
# these values when the auth share hostname changes; the OIDC issuer follows
# them without re-initialising the database.
# ZITADEL_EXTERNALDOMAIN=vozlabauth.share.zrok.io
# ZITADEL_EXTERNALPORT=443
# ZITADEL_EXTERNALSECURE=true

OIDC_CLIENT_ID=<printed by scripts/setup-zitadel.sh>
OIDC_CLIENT_SECRET=<printed by scripts/setup-zitadel.sh>
OIDC_ISSUER=http://localhost:8081
OIDC_AUTH_URL=http://localhost:8081/oauth/v2/authorize
OIDC_TOKEN_URL=http://localhost:8081/oauth/v2/token
OIDC_USERINFO_URL=http://localhost:8081/oidc/v1/userinfo
OIDC_JWKS_URL=http://localhost:8081/oauth/v2/keys
OIDC_SCOPES=openid profile email urn:zitadel:iam:org:id:<org-id>

# Local mode (default): web :5173 calls the API :3000 directly. This matches the
# setup script defaults and the AGENTS.md workflow.
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# PWA origin: CORS allowlist and the post-login redirect target.
WEB_ORIGIN=http://localhost:5173

# --- zrok demo shares (optional) ---
# Three reserved public shares that expose the web, the API and the Zitadel
# login UI independently. No reverse proxy: the PWA points at the API share
# directly (PUBLIC_API_BASE_URL is set by scripts/demo.sh).
ZROK_WEB_URL=https://vozlabdemo.share.zrok.io
ZROK_API_URL=https://vozlabapi.share.zrok.io
ZROK_AUTH_URL=https://vozlabauth.share.zrok.io
# Share tokens used by `./scripts/demo.sh` (secrets: keep them only in .env).
# ZROK_WEB_SHARE_TOKEN=<reserved share token for :5173>
# ZROK_API_SHARE_TOKEN=<reserved share token for :3000>
# ZROK_AUTH_SHARE_TOKEN=<reserved share token for :8081>

# --- LLM / Embeddings ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Python workers (dev) ---
# The workers read these only when they mint their own agent token with
# JWT_SECRET (development path, ADR-0021). Production workers use
# AGENT_TOKEN or AGENT_TOKEN_FILE instead.
# The identity values are the dev fixtures from
# `packages/database/scripts/dev-identities.ts`:
#   embedder    -> AGENT_EMBEDDER   (44444444-...-448)
#   agent       -> AGENT_RELACIONADOR (44444444-...-447)
AGENT_TENANT_KEY=sabana
AGENT_USER_ID=44444444-4444-4444-8444-444444444448
AGENT_AUTHOR_HASH=3909e5bbd80f2f103337546c552c3cca60be32c2d47f9be64d641ea001c3250b
# Chat model used by the Relator (the embedder uses EMBEDDING_MODEL).
OLLAMA_CHAT_MODEL=llama3.1:8b

# --- Rate limiting ---
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Coarse per-workspace ceiling = per-actor max × this factor.
RATE_LIMIT_WORKSPACE_MULTIPLIER=10

# --- Agent tooling (development only) ---
# Password of the read-only `mcp_reader` role provisioned by
# `pnpm --filter @vozlab/database db:grant-mcp-reader`. The role can only
# SELECT from the tenant database; it cannot write and cannot reach the
# router database. Keep it in sync with
# `mcp.servers.postgres.environment.DATABASE_URI` in `opencode.json`.
MCP_READER_PASSWORD=vozlab_mcp_local
# Personal access token for the GitHub MCP server. It is read from the
# process environment, not from this file: `export GITHUB_PERSONAL_ACCESS_TOKEN=...`
# before starting OpenCode. Leave unset to leave the server unconfigured.

# --- Observability ---
LOG_LEVEL=info
LOG_PRETTY=true
