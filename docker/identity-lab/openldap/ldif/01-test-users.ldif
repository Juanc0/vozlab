# Test users and groups for VozLab identity lab
# Loaded automatically on first start by osixia/openldap

# Organizational unit for people
dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people

# Organizational unit for groups
dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups

# Group: students
dn: cn=students,ou=groups,dc=example,dc=org
objectClass: posixGroup
cn: students
gidNumber: 20001
memberUid: alice
memberUid: bob
memberUid: carol

# Group: faculty
dn: cn=faculty,ou=groups,dc=example,dc=org
objectClass: posixGroup
cn: faculty
gidNumber: 20002
memberUid: dave
memberUid: eve

# Group: admins
dn: cn=admins,ou=groups,dc=example,dc=org
objectClass: posixGroup
cn: admins
gidNumber: 20003
memberUid: alice

# User: alice
dn: uid=alice,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: alice
cn: Alice Test
sn: Test
givenName: Alice
mail: alice@example.org
userPassword: alicepass
uidNumber: 10001
gidNumber: 20001
homeDirectory: /home/alice

# User: bob
dn: uid=bob,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: bob
